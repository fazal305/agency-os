# Supabase (database, auth, storage)
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend (transactional email) — leave unset to run in test mode (emails are
# logged, not sent)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Public site URL, used for absolute links in emails and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional booking link shown for kickoff calls until a live scheduling
# integration is configured (Calendly, Google Calendar, etc.)
NEXT_PUBLIC_BOOKING_URL=
